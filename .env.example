# Copy to .env and fill in. Never commit .env.

# Gemini (required) — get key at https://aistudio.google.com/apikey
GOOGLE_LIVE_WS=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GOOGLE_LIVE_WS_API=<paste-your-gemini-api-key>

# Exotel (for real calls)
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SUBDOMAIN=
# EXOTEL_SID=
# EXOTEL_SALES_AGENT_APP_ID=
# EXOTEL_CALLER_ID=

# Optional: Redis (outbound call mapping)
# REDIS_URL=

# Optional: tune latency / interruption — see 10_MINUTE_GUIDE.md
# GEMINI_SILENCE_DURATION_MS=280
# EXOTEL_VAD_RMS_THRESHOLD=750
# CALL_TIMEOUT_SECONDS=1800
