# ═══════════════════════════════════════════════════════════════════════════
# Exotel Voice Bot Framework - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# AI Provider API Keys (choose one or more based on your bot)
# ───────────────────────────────────────────────────────────────────────────

# OpenAI - For GPT-4, Whisper STT, TTS
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ElevenLabs - For Conversational AI
# Get key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_AGENT_ID=your-agent-id-here

# Google Gemini - For Gemini AI
# Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza-your-key-here

# ───────────────────────────────────────────────────────────────────────────
# Exotel API Configuration (for making outbound calls)
# ───────────────────────────────────────────────────────────────────────────

# Get from Exotel Dashboard
EXOTEL_API_KEY=your-api-key
EXOTEL_API_TOKEN=your-api-token
EXOTEL_ACCOUNT_SID=your-account-sid
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=+91YYYYYYYYYY
EXOTEL_FLOW_ID=your-flow-id

# ───────────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────────

# Server port (default: 5001)
PORT=5001

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable SSL (set to true for production)
# SSL_ENABLED=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# ───────────────────────────────────────────────────────────────────────────
# Optional: ngrok URL for development
# ───────────────────────────────────────────────────────────────────────────
# WSS_URL=wss://your-ngrok-url.ngrok.io/media
