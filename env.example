# Voice AI Bot Configuration
# Copy this file to .env and fill in your values

# Required Settings
OPENAI_API_KEY=your-openai-api-key-here
COMPANY_NAME=Your Company Name
SALES_BOT_NAME=Sarah

# Exotel Connect Voice AI (smoke test via scripts/place_connect_call.py)
# See docs/DOGRAH_AGENTSTREAM_INTEGRATION.md
EXOTEL_ACCOUNT_SID=your-exotel-account-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_CALLER_ID=+91XXXXXXXXXX
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_STREAM_URL=wss://localhost:5000/ws

# Optional Settings (defaults provided)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SAMPLE_RATE=8000
AUDIO_CHUNK_SIZE=200
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_VOICE=coral
LOG_LEVEL=INFO
