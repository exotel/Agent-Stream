# xAI Grok Voice (speech-to-speech) — Exotel AgentStream
# Docs: https://docs.x.ai/developers/model-capabilities/audio/voice-agent

XAI_API_KEY=
GROK_MODEL=grok-voice-latest
GROK_VOICE=eve
GROK_SILENCE_MS=600
GREETING_TEXT=Hello! How can I help you today?
