# AWS: leave the keys empty to use your AWS profile / SSO / EC2 or ECS role
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Nova Sonic
NOVA_MODEL=amazon.nova-2-sonic-v1:0
NOVA_VOICE=matthew
NOVA_ENDPOINTING=MEDIUM
# Overrides system_prompt.md when set
SYSTEM_PROMPT=

# Used only when the StreamUrl has no ?sample-rate= (8000 | 16000 | 24000)
EXOTEL_SAMPLE_RATE=16000

# Optional: only for ../../../shared/place_connect_call.py
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=

SERVER_HOST=0.0.0.0
SERVER_PORT=8765
