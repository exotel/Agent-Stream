OPENAI_API_KEY=your-openai-api-key-here
COMPANY_NAME=Your Company Name
SALES_BOT_NAME=Sarah

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SAMPLE_RATE=8000
DEFAULT_SAMPLE_RATE=8000
OPENAI_MODEL=gpt-realtime
OPENAI_VOICE=coral
LOG_LEVEL=INFO

# Debug only — causes a beep before the greeting when true
SEND_TEST_TONE=false

# AgentStream outbound: 200ms = 3200 bytes @ 8 kHz (Exotel min chunk)
EXOTEL_OUTBOUND_FRAME_MS=200
OPENAI_RESAMPLE_BLOCK_MS=200
# 0 = send frames ASAP (low latency); 0.9 ≈ realtime pacing
OUTBOUND_PACE_FACTOR=0
# Skip mic→OpenAI while bot audio plays
HALF_DUPLEX=true
# Pre-cache TTS greeting and play on start before Realtime connects
INSTANT_GREETING=true
