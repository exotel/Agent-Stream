{
  "name": "exotel-voice-bot",
  "version": "1.0.0",
  "description": "Enterprise-grade AI voice bot framework for Exotel - build conversational voice bots with GPT-4, Gemini, and more",
  "main": "index.js",
  "scripts": {
    "start": "node examples/simple-conversation-bot.js",
    "chat-bot": "node examples/simple-conversation-bot.js",
    "s2s-bot": "node examples/speech-to-speech-bot.js",
    "gemini-bot": "node examples/gemini-speech-to-speech-bot.js",
    "gemini-live": "node examples/gemini-live-bridge.js",
    "gemini-eleven": "node examples/gemini-elevenlabs-bot.js",
    "elevenlabs-bot": "node examples/elevenlabs-bridge.js",
    "openai-realtime": "node examples/openai-realtime-bot.js",
    "call": "node scripts/make-call.js",
    "dev": "nodemon examples/simple-conversation-bot.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:bots": "node tests/bot-test.js",
    "lint": "eslint src/ examples/ --ext .js,.ts",
    "lint:fix": "eslint src/ examples/ --ext .js,.ts --fix",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "docker:build": "docker build -t exotel-voice-bot .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "health": "curl -s http://localhost:5001/health | jq .",
    "clean": "rm -rf dist coverage node_modules/.cache"
  },
  "keywords": [
    "exotel",
    "voice-bot",
    "websocket",
    "ai",
    "gpt-4",
    "gemini",
    "stt",
    "tts",
    "llm",
    "conversational-ai",
    "speech-to-text",
    "text-to-speech",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.27",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.17.0",
    "@deepgram/sdk": "^3.4.0",
    "@google-ai/generativelanguage": "^2.5.0",
    "@google-cloud/speech": "^6.5.0",
    "@google-cloud/text-to-speech": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^1.0.0",
    "assemblyai": "^4.4.0",
    "elevenlabs": "^0.8.1",
    "groq-sdk": "^0.3.0",
    "openai": "^4.28.0"
  }
}
